
all:
	$(MAKE) -C src all

libs:
	$(MAKE) -C src libs

pkgs:
	$(MAKE) -C src pkgs

sims: pkgs

apps:
	$(MAKE) -C src apps

.PHONY: install INSTALL Install
install:
	$(MAKE) -C src install
	$(MAKE) -C docs install
	$(MAKE) install_sdk

# ucSim hardware-plugin SDK (loadable cl_hw modules).
prefix		= @prefix@
exec_prefix	= @exec_prefix@
datarootdir	= @datarootdir@
datadir		= @datadir@
includedir	= @includedir@

.PHONY: install_sdk uninstall_sdk
install_sdk:
	cd sdk && ./export-headers.sh && \
	  ./install.sh "$(DESTDIR)" "$(prefix)" "$(includedir)" "$(datadir)"

uninstall_sdk:
	rm -rf "$(DESTDIR)$(includedir)/ucsim" "$(DESTDIR)$(datadir)/ucsim/sdk"

uninstall:
	$(MAKE) -C src uninstall
	$(MAKE) -C docs uninstall
	$(MAKE) uninstall_sdk

clean: local_clean sub_clean

local_clean:
	rm -f *~ lib*.a

sub_clean:
	$(MAKE) -C src  -f clean.mk clean
	$(MAKE) -C docs -f clean.mk clean

distclean: local_distclean sub_distclean

local_distclean: local_clean
	rm -f config.log config.status
	rm -rf autom4te.cache
	rm -f Makefile

sub_distclean:
	$(MAKE) -C src  -f clean.mk distclean
	$(MAKE) -C docs -f clean.mk distclean

conf: configure

configure: src/configure.ac
	autoconf $< >$@
